# ============================================================

# --- 开场 / 结束 ---
const OPENING := [
	"嗨，我是「杠精老师 · 逻辑裁判」。你先抛观点，我拿逻辑漏洞来杠你。",
	"来。先亮出你的立场，我看看它站不站得住。",
]

const ENDING := [
	"本轮结束。记住：赢辩论靠的不是嗓门，是证据与论证结构。",
	"好了，交锋先到这。你在变强——再多练几回合。",
]

# --- 鼓励（用户像在讲理时） ---
const PRAISE := [
	"这句有点在讲道理了。",
	"有证据的味道了，继续保持。",
	"哦？这次我没太挑出刺，不错。",
	"好的——你已经开始用结构说话了。",
]

# --- 苏格拉底式追问（兜底） ---
const SOCRATIC := [
	"你说的“{kw}”具体指什么？先用一句你能验证的话定义清楚。",
	"这个结论依托一个前提：{kw}。你能证明它吗？",
	"站到反对你的人的立场上，他会怎么反驳你这句话？",
	"你的“{kw}”在什么情况下会不成立？举个反例？",
	"按你这么说往下推，会推出什么后果？你真接受那个后果吗？",
	"这句是真的，还是仅仅你觉得它真？什么证据能让你改变看法？",
	"假如有人拿一个完全相反的例子，你怎么排除它？",
]

# --- 通用攻击（无谬误时） ---
const ATTACKS := [
	"这属于「断言」，还缺证据。把它变成「主张+理由+证据」三件套。",
	"你从 A 一下跳到了 B。中间那根连接（Warrant）靠什么撑？",
	"这更像溯因推理（最佳解释）。可还有别的假设也能解释它，你排除得了吗？",
	"你用了类比。可类比的两样东西，本质特点一样吗？还是只是表面像？",
	"你用了“总是/都”——这是以偏概全的陷阱。有反例吗？",
	"给我一个可核验的来源，我就认真对待。给不出，它暂时只是个观点。",
	"这像把「结果」当「原因」了吧？谁先谁后你真确定？",
	"你这段缺少限定词：是“必然”还是“很可能”？强度说清楚。",
]

# --- 归谬术 ---
const REDUCTIO := [
	"照你这么说，推下去就得承认「{kw}」——你觉得这合理吗？",
	"按你的逻辑走到底：「{kw}」。如果这明显荒谬，说明你前面那个前提站不住。",
]

