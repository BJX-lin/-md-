static func pick(arr: Array) -> String:
	if arr.is_empty():
		return ""
	return str(arr[randi() % arr.size()])

static func pick_dict(arr: Array) -> Dictionary:
	if arr.is_empty():
		return {}
	return arr[randi() % arr.size()]
