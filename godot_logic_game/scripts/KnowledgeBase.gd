# --- 命中谬误后的“三连击”模板：识别 → 拆解 → 追问 ---
const FALLACY_RESPONSE_TEMPLATE := [
	"【我注意到了】{name}。",
	"【为什么错】{explain}",
	"【我的反问】{probe}",
	"【还有一招】{reductio}",
]

# --- 工具函数：随机取一项 ---
static func pick(arr: Array):
	if arr.is_empty():
		return ""
	return arr[randi() % arr.size()]
